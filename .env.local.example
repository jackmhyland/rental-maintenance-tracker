# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit actual secrets.

# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (Project Settings -> API). Not currently used for
# direct browser queries in this app (all DB access is server-side), but
# required by the assignment spec / kept for future client-side use.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (Project Settings -> API). SERVER-SIDE ONLY.
# This key bypasses Row Level Security, so it must never be exposed to the
# browser or committed to git. Do not prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Anthropic API key. SERVER-SIDE ONLY — used only in API route handlers.
ANTHROPIC_API_KEY=

# Optional: if set, the /api/cron/follow-up route requires this exact value
# in an "Authorization: Bearer <value>" header. Vercel sends this
# automatically for scheduled Cron Jobs when CRON_SECRET is configured as a
# project environment variable. Safe to leave unset for local development.
CRON_SECRET=
